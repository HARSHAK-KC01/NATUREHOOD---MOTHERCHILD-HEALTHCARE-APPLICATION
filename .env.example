# ==============================================================================
# NURTUREHOOD - SUPABASE BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# 1. Create a project at https://supabase.com
# 2. Go to: Project Settings -> API
# 3. Copy "Project URL" into VITE_SUPABASE_URL
# 4. Copy "anon public" Project API key into VITE_SUPABASE_ANON_KEY
# 5. Run the SQL script in "supabase/schema.sql" in Supabase SQL Editor

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
